# firekaro_v6 backend — copy to .env and fill in. NEVER commit the real .env.

# Postgres connection — Supabase project `firekaro-planner` (ap-south-1) via the SESSION POOLER.
# The direct `db.*.supabase.co` host is IPv6-only (P1001 over IPv4) — always use the pooler here.
# Standalone scripts run alongside the dev server MUST append `?connection_limit=1` (pooler caps at 15).
DATABASE_URL="postgresql://postgres.PROJECT_REF:CHANGE_ME@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?schema=public"

# Direct (non-pooled) URI for `schema.prisma`'s `directUrl` — used ONLY by `prisma migrate deploy` /
# `db push`, never by the runtime client. Without it `npm run prisma:migrate:deploy` fails fast with
# Prisma P1012 "Environment variable not found: DIRECT_URL" (see docs/DEPLOY.md §1). Not needed for
# `npm run dev` / `npm run test:unit`.
DIRECT_URL="postgresql://postgres.PROJECT_REF:CHANGE_ME@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?schema=public"

# Better Auth signing secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"

# Canonical origin used in the Google OAuth redirect URI.
BETTER_AUTH_URL="http://localhost:3100"

# CORS allow-list (comma-separated). mvp dev server runs on 5175.
ALLOWED_ORIGINS="http://localhost:5175"

# Google OAuth (optional in dev when DEV_BYPASS_AUTH=true).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Dev auth bypass — 3-factor gate (see rules/dev-bypass-auth.md).
# ALL THREE must hold: NODE_ENV=development|test + DEV_BYPASS_AUTH=true + x-dev-bypass header.
# The bypass now requires an EXPLICIT dev/test NODE_ENV (below). An unset NODE_ENV
# with DEV_BYPASS_AUTH=true refuses to boot, so a misconfigured VPS cannot leak.
DEV_BYPASS_AUTH="true"

# Server port.
PORT="3100"

# NODE_ENV — REQUIRED to be explicit when DEV_BYPASS_AUTH=true.
# Use "development" locally; set "production" on the VPS (with DEV_BYPASS_AUTH=false).
NODE_ENV="development"

# ── WhatsApp / Wati.io (Phase 1 engagement — docs/whatsapp-wati-integration.md) ──
# From Wati → Settings → API & Webhooks → API Docs. Endpoint = base URL; token =
# the Access Token (no "Bearer " prefix). Optional — the channel is off when unset.
WATI_API_ENDPOINT=""
WATI_API_TOKEN=""
# SAFETY allowlist (digits, no '+', comma-separated). The adapter is FAIL-CLOSED:
# until WATI_ALLOW_ALL_RECIPIENTS="true", it ONLY sends to numbers in this list.
WATI_TEST_RECIPIENTS=""
WATI_ALLOW_ALL_RECIPIENTS="false"

# Shared secret guarding the lifecycle scheduler endpoint POST /api/internal/lifecycle/run
# (the daily VPS cron sends it as the x-internal-token header). High-entropy random string —
# `openssl rand -hex 32`. Unset ⇒ the endpoint returns 500 (scheduler disabled, fail-closed).
LIFECYCLE_RUN_TOKEN=""

# ── Zoho CRM (FireKaro lead sync) — India DC defaults; optional (off when unset) ──
# Client ID/Secret from a Self Client (api-console.zoho.in); refresh token minted
# from a grant code (scope ZohoCRM.modules.ALL).
ZOHO_ACCOUNTS_BASE="https://accounts.zoho.in"
ZOHO_API_BASE="https://www.zohoapis.in"
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
