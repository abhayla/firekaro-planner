# Frontend production build env — copy to `.env.production` on the build host
# (VPS or CI) before `npm run build`. Vite reads these at build time only.
#
# Same-origin in production: nginx serves the SPA and proxies /api to the
# backend, so the API base is the SPA's own origin → leave VITE_API_BASE_URL
# empty. (No cross-site cookies, no CORS.)

VITE_USE_SERVER_ADAPTER=on
VITE_API_BASE_URL=

# DEV bypass MUST NOT be enabled in a production build.
VITE_DEV_BYPASS=false
