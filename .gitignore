# dependencies
node_modules/
server/node_modules/

# build output
dist/
server/dist/
*.tsbuildinfo

# env / secrets (NEVER commit)
.env
.env.local
.env.*.local
server/.env
server/.env.local

# test / e2e artifacts
coverage/
playwright-report/
test-results/
test-evidence/
e2e/.auth/

# headed UI-verification screenshots (preserved per-run on disk; regenerable — see /verify-ui)
verification-screenshots/
verification-evidence/
prod-verify/
verify-*/

# all test/verification screenshots are regenerable — never commit them
# (the only tracked PNG, .claude/skills/app-login/last-run.png, stays — gitignore
#  does not untrack already-committed files)
*.png

# run artifacts
docs/goals/.run/
# /goal run worktree-claim lock (goal-creator §0.1; read by .githooks/pre-commit)
.goal-active.lock

# ephemeral hook counter + throwaway debug specs (regenerable, never commit)
.claude/.keepgoing-count
e2e/_*.spec.ts

# prisma generated client (regenerated via prisma generate)
server/node_modules/.prisma/

# logs / os
*.log
.DS_Store
Thumbs.db

# editor
.idea/
*.swp

# Playwright MCP scratch (snapshots/console/network dumps)
.playwright-mcp/
.claude/.overask-violations.log

# Local session checkpoints (working state)
.claude/sessions/
